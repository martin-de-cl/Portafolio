def surf_to_login_page():
    exit_counter = 0

    while True:
        try:
            driver.get(web)
            driver.implicitly_wait(5)
            driver.find_element_by_xpath('//a[@Class="login cboxElement"]').click()
            driver.switch_to.frame(driver.find_element_by_class_name('cboxIframe'))
            driver.find_element_by_id('optionsRadios2').click()
            driver.find_element_by_xpath('.//input[@id="inputRut"]').send_keys(b64decode(usr).decode('utf-8'))
            driver.find_element_by_xpath('.//input[@id="inputPassword"]').send_keys(b64decode(psw).decode('utf-8'))
            driver.find_element_by_xpath('.//button[text()[contains(.,"Entrar")]]').click()
            break
        except NoSuchElementException:
            exit_counter += 1
            if exit_counter > 10:
                print('Cant find Login site')
                break
        except TimeoutException:
            driver.refresh()

