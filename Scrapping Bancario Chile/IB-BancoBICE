    driver.switch_to.default_content()
    driver.find_element_by_xpath('//*[@id="MenuCTACTE"]/table/tbody/tr/td[1]/table/tbody/tr[2]/td[2]/a').click()

    cuenta_bank = driver.find_element_by_xpath('//*[@id="cont_izq_full_screen"]/table[1]/tbody/tr/td/form/table[2]/tbody/tr[1]/td/table/tbody/tr/td[1]/span[2]').text.replace('(', '').replace(')', '').replace('-', '')

    tabla = driver.find_element_by_xpath('//form[@name="form1"]/table[3]/tbody')

    for line in tabla.find_elements_by_tag_name('tr'):
        if len(line.find_elements_by_tag_name('td')):
            first_cell = True
            for col in line.find_elements_by_tag_name('td'):
                if first_cell is True:
                    if col != '':
                        aux_date = col
                    elif col == '':
                        col = aux_date
                    first_cell = False
                ls_celdas.append(col.text)
            ls_lineas_bancarias.append(ls_celdas)
            ls_celdas = []

    for _ in ls_lineas_bancarias:
        print(_)
    drop_cartola_output(formatting_lines(ls_lineas_bancarias, cuenta_bank), empresa)

