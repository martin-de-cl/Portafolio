def open_focus_window(driver, window_count=2):
    contador = 0
    old_name = driver.window_handles[0]
    driver.find_element_by_tag_name('html').send_keys(Keys.CONTROL + 'n')

    while True:
        try:
            new_name = driver.window_handles[1]
            if len(driver.window_handles) == window_count:
                break
        except:
            contador += 1
            time.sleep(2)
            if contador > 5:
                raise Exception('Problemas al abrir ventanas')

    driver.switch_to.window(new_name)

    return (old_name, new_name)


