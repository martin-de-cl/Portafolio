def check_for_pop_windows(driver, web_where_to_check):

    print(web_where_to_check)
    len(web_where_to_check)

    driver.switch_to.default_content()
    driver.switch_to.frame(driver.find_element_by_name('content'))

    w_base = driver.window_handles[0]

    body = driver.find_element_by_tag_name('body')
    driver.implicitly_wait(2)
    body.send_keys(Keys.CONTROL + 'n')
    driver.implicitly_wait(2)

    Vnew = driver.window_handles[1]
    driver.switch_to.window(Vnew)

    driver.get(web_where_to_check)

    try:
        driver.switch_to.frame("detalle")
        driver.close()
        driver.switch_to.window(w_base)
        return True
    except NoSuchFrameException:
        driver.close()
        driver.switch_to.window(w_base)
        return False


def get_hard_links(sigla_empresa):
    with open('./mods/hard_links_bci','r') as link_file:
        data = link_file.read().replace('\n','').replace('    ','')
    links_dict = ast.literal_eval(data)

    ls_saldos_clp = links_dict[sigla_empresa]['CLP']

    try:
        ls_saldos_usd = links_dict[sigla_empresa]['USD']

    except KeyError:
        ls_saldos_usd = None

    ls_link_dl = links_dict[sigla_empresa]['Download']

    int_cuentas_counter = int(links_dict[sigla_empresa]['Ccount'])

    return (ls_saldos_clp, ls_saldos_usd, ls_link_dl, int_cuentas_counter)


def get_saldos_clp(driver, ls_hl_pesos, frames):

    def busca_saldos(url):
        contador = 0
        driver.switch_to.default_content()
        driver.switch_to.frame(driver.find_element_by_name('content'))

        w_base = driver.window_handles[0]

        body = driver.find_element_by_tag_name('body')
        body.send_keys(Keys.CONTROL + 'n')
        while True:
            try:
                w_popu = driver.window_handles[1]
                break
            except IndexError:
                contador += 1
                if contador > 5:
                    raise Exception('Windows Handle error, CLP')

        driver.switch_to.window(w_popu)

        driver.get(url)
        try:
            driver.switch_to.frame("detalle")
        except NoSuchFrameException:
            driver.switch_to.frame("content")

        cuenta = driver.find_element_by_xpath(
            '//*[@id="contenidoPrint"]/table[1]/tbody/tr[2]/td').text[13:]
        saldo  = driver.find_element_by_xpath(
            '//*[@id="contenidoPrint"]/table[5]/tbody/tr/td/table[1]/tbody/tr[2]/td[2]').text.replace('$','')

        print('%s, %s' % (cuenta,saldo))
        driver.close()
        driver.switch_to.window(w_base)


    if ls_hl_pesos is list or ls_hl_pesos is tuple:
        for cuenta in ls_hl_pesos:
            busca_saldos(cuenta)
    else:
        busca_saldos(ls_hl_pesos)


