def get_cartolas(driver,hard_link_to_cartola, link_cuenta_usd, criterios, frames):

    def is_it_enough(fecha_de_cartolas, ultimo_dia_habil):
        # Busca dentro de un periodo de dos semanas, para agilizar la busqueda en caso
        # de que hayan muchos pendientes.
        temp_date = dt.datetime.strptime(fecha_de_cartolas,'%d/%m/%Y')
        today_date = dt.datetime.strptime(ultimo_dia_habil,'%d/%m/%Y')
        print('%s, %s'%(temp_date, today_date))
        if int((today_date - temp_date).days) >= 14:
            return False
        else:
            return True

    # la fecha de bci es la del día de hoy y la de lunes la del sabado
    last_work_day = dt.datetime.today().strftime('%d/%m/%Y')

    driver.switch_to.default_content()
    vold = driver.window_handles[0]
    driver.find_element_by_tag_name('html').send_keys(Keys.CONTROL + 'n')
    vnew = driver.window_handles[1]
    driver.switch_to.window(vnew)
    driver.get(hard_link_to_cartola)

    if frames is False:
        driver.switch_to.frame('content')
    else:
        driver.switch_to.frame('detalle')

    tabla_completa = driver.find_element_by_xpath('//*[@id="contenido"]/form/table[6]/tbody')

    for line in tabla_completa.find_elements_by_tag_name('tr')[1:]:

        if last_work_day in line.find_elements_by_tag_name('td')[1].text:
            if 'CTD' in line.find_elements_by_tag_name('td')[2].text:

