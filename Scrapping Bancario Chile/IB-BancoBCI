def surf_to_home(driver):

    driver.get(home_web)

    pc_width_res = sysmet(0)
    pc_height_res = sysmet(1)

    ff_width_res = driver.get_window_size()['width']
    ff_height_res = driver.get_window_size()['height']

    if int(pc_width_res)/int(ff_width_res) != 1 and int(pc_height_res)/int(ff_height_res) != 1:
        driver.maximize_window()


def login(driver, user):
    usr = b64decode(itemgetter(0)(user)).decode('utf-8') 
    psw = b64decode(itemgetter(1)(user)).decode('utf-8') 

    def old_login(rut, password):

        driver.switch_to.default_content()
        driver.find_element_by_name('rut_aux').send_keys(rut)
        driver.find_element_by_name('clave_aux').send_keys(password)

        try:
            driver.find_element_by_xpath('/html/body/div[4]/div[2]/div[2]/fieldset/div[1]/form/p[3]/input').click()
        except NoSuchElementException:
            driver.find_element_by_id('login').find_element_by_clas_name('centrar_btn_ingreso').click()

    def new_login(rut, pasword):
        driver.find_element_by_id('nav-menu').find_element_by_class_name('right-menu').click()
        driver.find_element_by_id('container-login').find_element_by_id('rut_aux').send_keys(rut)
        driver.find_element_by_id('container-login').find_element_by_id('clave_aux').send_keys(pasword)
        driver.find_element_by_id('container-login').find_element_by_id('clave_aux').send_keys(Keys.RETURN)

    try:
        old_login(usr, psw)
    except:
        new_login(usr, psw)


