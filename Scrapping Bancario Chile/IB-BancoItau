def get_driver():

    ffp = webdriver.FirefoxProfile()
    ffp.set_preference("browser.download.folderList", 2)
    ffp.set_preference("browser.download.manager.showWhenStarting", False)
    ffp.set_preference("browser.download.dir", mp.Banco('Corpbanca'))
    ffp.set_preference("browser.helperApps.neverAsk.saveToDisk",
                       "text/csv, text/force_download, application/csv, application/force_download")
    return webdriver.Firefox(ffp)


def aviso_handlers(driver):

    def aviso_1():
        driver.switch_to.default_content()
        driver.find_element_by_xpath('//div[@Class="close_content"]').click()
        return True

    ls_handlers = [aviso_1]

    for handler in ls_handlers:
