def get_saldo(driver):

    # Entrega los saldos en el formato necesario para el analisis de dato empresarial

    driver.switch_to.default_content()
    cuenta = driver.find_element_by_xpath('//span[@name="BicDescAccount"]').text.rsplit(' ',1)[1][-5:]

    saldo = driver.find_element_by_xpath('//span[@name="SALCON_iso8601"]').text.replace('.','').replace('$ ','')

    print('Cuenta %s, Saldo %s' % (cuenta, saldo))

    return ('SIGLABANCO', 'SIGLAEMPRESA', 'SIGLABANCO-CUENTA', saldo)


def drop_abonos_csv(CSVARC, tuple_csv):
    with open(CSVARC, 'a', newline='') as csvfile:
        sw = csv.writer(csvfile, delimiter=';', quotechar='|', quoting=csv.QUOTE_MINIMAL)
        #for empresa in tuple_csv:
        for line in tuple_csv:
            sw.writerow(line)

