        Var4 = Var3[2].find_element_by_tag_name('tbody').find_element_by_tag_name('tr')
        Var5 = Var4.find_element_by_tag_name('td')
        time.sleep(1)
        SaldoC = Var5.text[24:]
        print("%s, EST-%s, $ %s" % (siglaEMP, AXNumCta, SaldoC.replace(" ", "")))
        ls_saldos.append(('EST', siglaEMP, 'EST-' + AXNumCta, SaldoC))

    def get_saldo_from_last_tbl():
        driver.switch_to.default_content()
        driver.switch_to.frame(driver.find_element_by_xpath('//frame[@id="fr3"]'))

        saldo = driver.find_element_by_xpath('.//table[@Class="pantalla imprime2"]/tbody/tr/td/center/center/table/tbody/tr[6]/td[2]').text
        print("%s, EST-%s, $ %s" % (siglaEMP, AXNumCta, saldo))
        ls_saldos.append(('EST', siglaEMP, 'EST-' + AXNumCta, saldo.replace('.','')))

    stop_counter = 0
    while True:
        try:
            filas_his = driver.find_element_by_id('mDetalle').find_elements_by_xpath('.//tbody/tr')
            '//*[@id="mDetalle"]'
            break
        except NoSuchElementException:
            time.sleep(1)
            stop_counter += 1
            if stop_counter > 20:
                filas_his = None
                print('La tabla de Cargos nunca fue encontrada')
                break

    if filas_his is not None:
        if check_dates(reversed(filas_his)) is True:
            for fila in reversed(filas_his):
                if dt.datetime.today().weekday() == 0:
                    if (dt.datetime.today()-dt.timedelta(3)).strftime('%d/%m') in fila.find_elements_by_tag_name("td")[0].text:
                        ls_saldos.append(('EST', siglaEMP, 'EST-'+AXNumCta, fila.find_elements_by_tag_name("td")[6].text.replace('.','')))
                        print('%s, EST-%s, $ %s' % (siglaEMP, AXNumCta, fila.find_elements_by_tag_name("td")[6].text))
                        break
                else:
                    if tm.ayerS() in fila.find_elements_by_tag_name("td")[0].text:
                        ls_saldos.append(('EST', siglaEMP, 'EST-'+AXNumCta, fila.find_elements_by_tag_name("td")[6].text.replace('.','')))
                        print('%s, EST-%s, $ %s' % (siglaEMP, AXNumCta, fila.find_elements_by_tag_name("td")[6].text))
                        break
        else:
            get_saldo_from_last_tbl()
    else:
        get_cartola_en_linea()


def drop_abonos_csv(ls_with_abonos):
    with open(CSVARC, 'a', newline='') as csvfile:
        sw = csv.writer(csvfile, delimiter=';', quotechar='|', quoting=csv.QUOTE_MINIMAL)
        for line in ls_with_abonos:
            sw.writerow(line)


