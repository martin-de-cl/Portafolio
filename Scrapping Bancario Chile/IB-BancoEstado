class outlook_bot:

    def __init__(self, folder=None):
        self.outlook = win32com.client.Dispatch("Outlook.Application").GetNamespace("MAPI")
        if folder is not None:
            self.folder = self.outlook.Folders['Correo Martin Pimentel'].Folders['Bandeja de entrada'].Folders[folder]
        else:
            self.folder = self.outlook.Folders['Correo Martin Pimentel'].Folders['Bandeja de entrada']

    def list_files_to_dl(self, item):
        print([att for att in item.attachments])

    def mensajes_en_carpeta(self):
        return self.folder.Items


    @staticmethod
    def open_outlook():
        cmd = 'tasklist | find "OUTLOOK"'
        path_outlook_exe = os.path.abspath('C:\\Program Files (x86)\\Microsoft Office\\Office14\\OUTLOOK.EXE')

        time.sleep(10)
        if 'OUTLOOK' in run(cmd, bufsize=0, stdout=PIPE, stderr=PIPE, universal_newlines=0, shell=True).stdout.decode(
                'utf-8'):
            pass
        else:
            os.startfile(path_outlook_exe)

    @staticmethod
    def close_outlook():

        cmd = 'tasklist | find "OUTLOOK"'
        taskPID = run(cmd, bufsize=0, stdout=PIPE, stderr=PIPE, universal_newlines=0, shell=True).stdout.decode('utf-8')
        taskill = 'taskkill /PID %s' % taskPID.split(' ', maxsplit=1)[1].lstrip().split(' ', maxsplit=1)[0].rstrip()
        if 'OUTLOOK' in taskPID:
            run(taskill)

    @staticmethod
    def file_check(fileName):
        if os.path.exists(fileName):
            return True
        else:
            return False


class mypath:
    def Revpath(self):
        CWD = os.getcwd()
        Revpaths = CWD[:-14]
        return Revpaths
    def Saldos(self):
        CWD = os.path.realpath(__file__)
        Revpaths = CWD[:-14]
        Cuadraje = Revpaths+"Cuadraje\\Saldos"
        return Cuadraje
    def SaldosCSV(self):
        folder = os.path.dirname(os.path.abspath(__file__))
        Revpaths = os.path.sep.join(folder.split(os.path.sep)[:-2])
        Cuadraje = os.path.abspath(os.path.join(Revpaths+"/tmp/saldos_iniciales_online.csv"))
        return Cuadraje
    def Banco(self,IDBANCO):
        folder = os.path.dirname(os.path.abspath(__file__))
        Revpaths = os.path.sep.join(folder.split(os.path.sep)[:-2])
        Bancos = os.path.abspath(os.path.join(Revpaths + "/stdin/Cartolas_Bancos/" + IDBANCO))
        return Bancos
