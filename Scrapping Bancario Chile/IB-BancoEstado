    o_bot = outlook_bot('Cartolas')
    for item in reversed(o_bot.mensajes_en_carpeta()):
        stop += 1
        if item.Unread is True:
            for attach in item.attachments:
                if '.DAT' in attach.Filename:
                    attach.SaveAsFile(os.path.abspath(mp.Banco('Estado') +'/'+ attach.Filename))
        item.Unread = False

        if stop > 20:
            break


