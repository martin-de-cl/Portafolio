usr_usr    = b'dXNlcm5hbWU='
usr_client = b'dXNlcm5hbWVfY29tcGFueQ=='
psw = b'cGFzc3dvcmQ='


def get_bank_folder(banco):
    folder = os.path.dirname(os.path.abspath(__file__))
    Revpaths = os.path.sep.join(folder.split(os.path.sep)[:-2])
    Bancos = os.path.abspath(os.path.join(Revpaths + "/stdin/Cartolas_Bancos/" + banco))
    return Bancos

def get_csv_folder():
    folder = os.path.dirname(os.path.abspath(__file__))
    Revpaths = os.path.sep.join(folder.split(os.path.sep)[:-2])
    Cuadraje = os.path.abspath(os.path.join(Revpaths + "/tmp/saldos_iniciales_online.csv"))
    return Cuadraje

# ---- Navegacion ----

def get_webdriver(banco):
    ffp = webdriver.FirefoxProfile()
    ffp.set_preference("browser.download.folderList", 2)
    ffp.set_preference("browser.download.manager.showWhenStarting", False)
    ffp.set_preference("browser.download.dir", get_bank_folder(banco))
    ffp.set_preference("browser.helperApps.neverAsk.saveToDisk",
                       "text/html,bsarff/rff,application/xhtml+xml,application/xml;q=0.9,image/webp,*/*;q=0.8,text/csv,"
                       "application/octet-stream,zz-application/zz-winassoc-dat")
    return webdriver.Firefox(ffp)

def get_login(driver):
    count_to_exit = 0
    driver.get('https://www.scotiabank.cl/login/empresas/?nocache=true&_ga=1.41796007.400071827.1448623487')
    while True:
        try:
            driver.find_element_by_id('rutCliente').send_keys(b64decode(usr_client).decode('utf-8'))
            driver.find_element_by_id('rutUsuario').send_keys(b64decode(usr_usr).decode('utf-8'))
            driver.find_element_by_id('password').send_keys(b64decode(psw).decode('utf-8'))
            driver.find_element_by_xpath('//*[@id="login-form"]/input[11]').click()
            break
        except:
            count_to_exit += 1
            if count_to_exit == 10:
                break

def get_driver_quit(driver):
    driver.quit()

def surf_to_cartola(driver):
    count_to_exit = 0
    while True:
        try:
            driver.switch_to.default_content()
            driver.switch_to.frame(driver.find_element_by_xpath('/html/frameset/frameset/frameset/frame[2]'))

            if driver.find_element_by_xpath('//*[@id="menu"]/li[1]/ul/li[7]/a').is_displayed():
                driver.find_element_by_xpath('//*[@id="menu"]/li[1]/ul/li[7]/a').click()
                break
            else:
                driver.find_element_by_xpath('//*[@id="menu"]/li[1]/a').click()
                driver.find_element_by_xpath('//*[@id="menu"]/li[1]/ul/li[7]/a').click()
                break
        except NoSuchElementException:
            driver.implicitly_wait(1)
            count_to_exit += 1
            if count_to_exit == 10:
                break
        except ElementNotVisibleException:
            driver.switch_to.default_content()
            driver.switch_to.frame(driver.find_element_by_xpath('/html/frameset/frameset/frameset/frame[2]'))

def surf_to_saldos(driver):
    stop_counter = 0
    while True:
        try:
            driver.switch_to.default_content()
            driver.switch_to.frame(driver.find_element_by_xpath('/html/frameset/frameset/frameset/frame[2]'))
            driver.find_element_by_xpath('//*[@id="menu"]/li[1]/a').click()
            driver.find_element_by_xpath('//*[@id="menu"]/li[1]/ul/li[1]/a').click()
            break
        except NoSuchElementException:
            driver.implicitly_wait(1)
            stop_counter +=1
            if stop_counter == 10:
                break

def get_saldos(driver):

    def drop_abonos_csv(CSVARC, tuple_csv):
        with open(CSVARC, 'a', newline='') as csvfile:
            sw = csv.writer(csvfile, delimiter=';', quotechar='|', quoting=csv.QUOTE_MINIMAL)
            sw.writerow(tuple_csv)

    driver.switch_to.default_content()
    driver.switch_to.frame(driver.find_element_by_name('CONTENIDO'))
    cuenta = driver.find_element_by_xpath('//*[@id="contenido"]/div/table[1]/tbody/tr[1]/td[4]').text
    saldo = driver.find_element_by_xpath('//*[@id="contenido"]/div/table[2]/tbody/tr[1]/td[2]').text

    print('SCOT, SCF, SCOT-%s, $ %s' % (cuenta.replace('-','')[-5:], saldo))
    tuple_saldo = ('SCOT','SCF','SCOT-'+cuenta.replace('-','')[-5:], saldo.replace('.',''))

    drop_abonos_csv(get_csv_folder(), tuple_saldo)

