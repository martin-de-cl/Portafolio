# ---- Dates ----

def give_dates_for_a_week(driver):
    driver.switch_to.default_content()
    driver.switch_to.frame(driver.find_element_by_xpath('/html/frameset/frameset/frame'))

    f_inicio = dt.datetime.today()-dt.timedelta(6)
    f_fin    = dt.datetime.today()

    stop_counter = 0
    while True:
        try:
            #---Fecha de Inicio, -7 ---
            driver.find_element_by_name('idd').clear()
            driver.find_element_by_name('idd').send_keys(f_inicio.strftime('%d'))
            driver.find_element_by_name('imm').clear()
            driver.find_element_by_name('imm').send_keys(f_inicio.strftime('%m'))
            driver.find_element_by_name('iaa').clear()
            driver.find_element_by_name('iaa').send_keys(f_inicio.strftime('%Y'))

            #---Fecha de Fin, hoy   ---
            driver.find_element_by_name('fdd').clear()
            driver.find_element_by_name('fdd').send_keys(f_fin.strftime('%d'))
            driver.find_element_by_name('fmm').clear()
            driver.find_element_by_name('fmm').send_keys(f_fin.strftime('%m'))
            driver.find_element_by_name('faa').clear()
            driver.find_element_by_name('faa').send_keys(f_fin.strftime('%Y'))
            break
        except NoSuchElementException:
            driver.switch_to.default_content()
            driver.switch_to.frame(driver.find_element_by_name('CONTENIDO'))
            stop_counter += 1
            if stop_counter > 10:
                print('Imposible encontrar el lugar de las fechas')
                break

    #--- Go in ---

